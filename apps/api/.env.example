NODE_ENV=development
PORT=4000
API_DOCS_ENABLED=true

# Copy into ignored apps/api/.env.local only if that file does not already exist.
# Runtime: Supabase Connect > Transaction pooler (shared pooler, port 6543).
# Required to start the API; the client connects lazily on its first query.
DATABASE_URL=
# Prisma CLI: Supabase Connect > Session pooler (shared pooler, port 5432).
# Required only for database-connected CLI commands; no runtime URL fallback.
DIRECT_URL=
# Use the dashboard's actual host, database, username and URL-encoded DB password.
# Download the trusted CA from the authenticated project's Database > Settings dashboard.
# Runtime URL: sslmode=verify-full&sslrootcert=<URL-encoded absolute CA file path>
# CLI URL: sslmode=require&sslaccept=strict&sslcert=<URL-encoded absolute CA file path>
# These CA parameter names differ: pg's sslcert means a CLIENT certificate, not the server CA.
# See docs/database/SUPABASE_CONNECTIONS.md. Never put database URLs in frontend files.

# Reserved for future integrations.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
