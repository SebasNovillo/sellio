NODE_ENV=development
PORT=4000
API_DOCS_ENABLED=true

# Required for the API's lazy database client. No connection occurs until a query.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sellio
# Optional direct/privileged connection for future migrations; falls back to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://MIGRATOR:PASSWORD@localhost:5432/sellio

# Reserved for future integrations.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
