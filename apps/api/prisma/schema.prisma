// PostgreSQL CHECKs and partial indexes are maintained in the initial migration.
// See docs/database/PRISMA_FOUNDATION.md for the custom SQL and service invariants.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum CategoryStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("category_status")
}

enum VariantStatus {
  ACTIVE
  INACTIVE

  @@map("variant_status")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum CheckoutAttemptStatus {
  RECEIVED
  PROCESSING
  AWAITING_PAYMENT
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED

  @@map("checkout_attempt_status")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum InventoryMovementReason {
  RECEIPT
  ADJUSTMENT
  SALE
  RETURN
  CORRECTION

  @@map("inventory_movement_reason")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("payment_status")
}

enum PaymentProvider {
  STRIPE

  @@map("payment_provider")
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED

  @@map("payment_event_status")
}

enum ReconciliationStatus {
  NONE
  REQUIRED
  RESOLVED

  @@map("reconciliation_status")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId    String   @unique(map: "user_auth_id_key") @map("auth_id") @db.Uuid
  email     String   @db.Text
  firstName String?  @map("first_name") @db.Text
  lastName  String?  @map("last_name") @db.Text
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses          Address[]
  carts              Cart[]
  checkoutAttempts   CheckoutAttempt[]
  orders             Order[]             @relation("OrderOwner")
  inventoryMovements InventoryMovement[] @relation("MovementActor")
  resolvedOrders     Order[]             @relation("OrderReconciliationResolver")
  resolvedPayments   Payment[]           @relation("PaymentReconciliationResolver")

  @@map("user")
}

model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.Text
  line1         String   @db.Text
  line2         String?  @db.Text
  city          String   @db.Text
  region        String?  @db.Text
  postalCode    String   @map("postal_code") @db.Text
  countryCode   String   @map("country_code") @db.Char(2)
  phone         String?  @db.Text
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "address_user_id_idx")
  @@map("address")
}

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.Text
  slug      String    @unique(map: "brand_slug_key") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("brand")
}

model Category {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String            @db.Text
  slug      String            @unique(map: "category_slug_key") @db.Text
  parentId  String?           @map("parent_id") @db.Uuid
  status    CategoryStatus
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children  Category[]        @relation("CategoryHierarchy")
  products  ProductCategory[]

  @@index([parentId], map: "category_parent_id_idx")
  @@map("category")
}

model Product {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @db.Text
  slug        String            @unique(map: "product_slug_key") @db.Text
  description String?           @db.Text
  status      ProductStatus
  brandId     String?           @map("brand_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand       Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories  ProductCategory[]
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]

  @@index([status, createdAt], map: "product_status_created_at_idx")
  @@index([brandId], map: "product_brand_id_idx")
  @@map("product")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId], map: "product_category_category_id_product_id_idx")
  @@map("product_category")
}

model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  storagePath String   @map("storage_path") @db.Text
  altText     String   @map("alt_text") @db.Text
  position    Int
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([productId, position], map: "product_image_product_id_position_idx")
  @@map("product_image")
}

model ProductOption {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String               @map("product_id") @db.Uuid
  name      String               @db.Text
  position  Int
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  values    ProductOptionValue[]

  @@unique([productId, name], map: "product_option_product_id_name_key")
  @@map("product_option")
}

model ProductOptionValue {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId  String               @map("option_id") @db.Uuid
  value     String               @db.Text
  position  Int
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  option    ProductOption        @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variants  VariantOptionValue[]

  @@unique([optionId, value], map: "product_option_value_option_id_value_key")
  @@map("product_option_value")
}

model ProductVariant {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  sku             String               @unique(map: "product_variant_sku_key") @db.Text
  price           Decimal              @db.Decimal(12, 2)
  compareAtPrice  Decimal?             @map("compare_at_price") @db.Decimal(12, 2)
  currency        String               @db.Char(3)
  status          VariantStatus
  isDefault       Boolean              @default(false) @map("is_default")
  optionSignature String               @map("option_signature") @db.VarChar(1024)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  optionValues    VariantOptionValue[]
  inventoryItem   InventoryItem?
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([productId, optionSignature], map: "product_variant_product_id_option_signature_key")
  @@index([productId, status], map: "product_variant_product_id_status_idx")
  @@map("product_variant")
}

model VariantOptionValue {
  variantId     String             @map("variant_id") @db.Uuid
  optionValueId String             @map("option_value_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId], map: "variant_option_value_option_value_id_idx")
  @@map("variant_option_value")
}

model InventoryItem {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String                 @unique(map: "inventory_item_variant_id_key") @map("variant_id") @db.Uuid
  quantityOnHand   Int                    @default(0) @map("quantity_on_hand")
  quantityReserved Int                    @default(0) @map("quantity_reserved")
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservations     InventoryReservation[]
  movements        InventoryMovement[]

  @@map("inventory_item")
}

model InventoryReservation {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId   String              @map("inventory_item_id") @db.Uuid
  checkoutAttemptId String              @map("checkout_attempt_id") @db.Uuid
  orderId           String              @map("order_id") @db.Uuid
  quantity          Int
  status            ReservationStatus
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryItem     InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkoutAttempt   CheckoutAttempt     @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements         InventoryMovement[]

  @@unique([checkoutAttemptId, inventoryItemId], map: "inventory_reservation_attempt_item_key")
  @@index([status, expiresAt], map: "inventory_reservation_status_expires_at_idx")
  @@index([orderId], map: "inventory_reservation_order_id_idx")
  @@index([inventoryItemId], map: "inventory_reservation_inventory_item_id_idx")
  @@map("inventory_reservation")
}

model InventoryMovement {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String                  @map("inventory_item_id") @db.Uuid
  quantityDelta   Int                     @map("quantity_delta")
  reason          InventoryMovementReason
  orderId         String?                 @map("order_id") @db.Uuid
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  reservationId   String?                 @map("reservation_id") @db.Uuid
  note            String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order           Order?                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor           User?                   @relation("MovementActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reservation     InventoryReservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([inventoryItemId, createdAt], map: "inventory_movement_item_created_at_idx")
  @@index([orderId], map: "inventory_movement_order_id_idx")
  @@index([actorUserId], map: "inventory_movement_actor_user_id_idx")
  @@index([reservationId], map: "inventory_movement_reservation_id_idx")
  @@map("inventory_movement")
}

model Cart {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  guestTokenHash   String?           @map("guest_token_hash") @db.Text
  status           CartStatus
  revision         Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items            CartItem[]
  checkoutAttempts CheckoutAttempt[]
  order            Order?            @relation("OrderSourceCart")

  @@index([userId], map: "cart_user_id_idx")
  @@map("cart")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([cartId, variantId], map: "cart_item_cart_id_variant_id_key")
  @@index([variantId], map: "cart_item_variant_id_idx")
  @@map("cart_item")
}

model CheckoutAttempt {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String                 @map("user_id") @db.Uuid
  cartId                   String                 @map("cart_id") @db.Uuid
  cartRevision             Int                    @map("cart_revision")
  idempotencyKey           String                 @map("idempotency_key") @db.VarChar(128)
  requestFingerprint       String                 @map("request_fingerprint") @db.Char(64)
  fingerprintVersion       Int                    @map("fingerprint_version") @db.SmallInt
  requestSnapshot          Json                   @map("request_snapshot") @db.JsonB
  status                   CheckoutAttemptStatus
  orderId                  String?                @unique(map: "checkout_attempt_order_id_key") @map("order_id") @db.Uuid
  processingToken          String?                @map("processing_token") @db.Uuid
  processingLeaseExpiresAt DateTime?              @map("processing_lease_expires_at") @db.Timestamptz(6)
  retryCount               Int                    @default(0) @map("retry_count")
  nextRetryAt              DateTime?              @map("next_retry_at") @db.Timestamptz(6)
  retentionExpiresAt       DateTime?              @map("retention_expires_at") @db.Timestamptz(6)
  lastErrorCode            String?                @map("last_error_code") @db.Text
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cart                     Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order                    Order?                 @relation("CheckoutResult", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reservations             InventoryReservation[]

  @@unique([userId, idempotencyKey], map: "checkout_attempt_user_id_idempotency_key_key")
  @@index([status, nextRetryAt], map: "checkout_attempt_status_next_retry_at_idx")
  @@index([retentionExpiresAt], map: "checkout_attempt_retention_expires_at_idx")
  @@index([cartId, createdAt], map: "checkout_attempt_cart_id_created_at_idx")
  @@map("checkout_attempt")
}

model Order {
  id                             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber                    String                 @unique(map: "order_order_number_key") @map("order_number") @db.Text
  userId                         String                 @map("user_id") @db.Uuid
  sourceCartId                   String                 @unique(map: "order_source_cart_id_key") @map("source_cart_id") @db.Uuid
  status                         OrderStatus
  currency                       String                 @db.Char(3)
  subtotal                       Decimal                @db.Decimal(12, 2)
  shippingTotal                  Decimal                @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal                       Decimal                @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal                  Decimal                @map("discount_total") @db.Decimal(12, 2)
  grandTotal                     Decimal                @map("grand_total") @db.Decimal(12, 2)
  taxDetailsSnapshot             Json?                  @map("tax_details_snapshot") @db.JsonB
  shippingMethodSnapshot         Json?                  @map("shipping_method_snapshot") @db.JsonB
  acceptedPaymentId              String?                @unique(map: "order_accepted_payment_id_key") @map("accepted_payment_id") @db.Uuid
  reconciliationStatus           ReconciliationStatus   @default(NONE) @map("reconciliation_status")
  reconciliationReason           String?                @map("reconciliation_reason") @db.Text
  reconciliationDetectedAt       DateTime?              @map("reconciliation_detected_at") @db.Timestamptz(6)
  reconciliationResolvedAt       DateTime?              @map("reconciliation_resolved_at") @db.Timestamptz(6)
  reconciliationResolvedByUserId String?                @map("reconciliation_resolved_by_user_id") @db.Uuid
  reconciliationResolutionNote   String?                @map("reconciliation_resolution_note") @db.Text
  paidAt                         DateTime?              @map("paid_at") @db.Timestamptz(6)
  createdAt                      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                           User                   @relation("OrderOwner", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceCart                     Cart                   @relation("OrderSourceCart", fields: [sourceCartId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkoutAttempt                CheckoutAttempt?       @relation("CheckoutResult")
  acceptedPayment                Payment?               @relation("AcceptedPayment", fields: [acceptedPaymentId, id], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  reconciliationResolvedBy       User?                  @relation("OrderReconciliationResolver", fields: [reconciliationResolvedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  items                          OrderItem[]
  address                        OrderAddress?
  payments                       Payment[]              @relation("OrderPayments")
  reservations                   InventoryReservation[]
  inventoryMovements             InventoryMovement[]

  @@unique([acceptedPaymentId, id], map: "order_accepted_payment_id_id_key")
  @@index([userId, createdAt], map: "order_user_id_created_at_idx")
  @@index([reconciliationStatus, updatedAt], map: "order_reconciliation_status_updated_at_idx")
  @@index([reconciliationResolvedByUserId], map: "order_reconciliation_resolver_idx")
  @@map("order")
}

model OrderItem {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  variantId           String?         @map("variant_id") @db.Uuid
  productNameSnapshot String          @map("product_name_snapshot") @db.Text
  skuSnapshot         String          @map("sku_snapshot") @db.Text
  optionsSnapshot     Json            @map("options_snapshot") @db.JsonB
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal         @map("line_total") @db.Decimal(12, 2)
  taxTotal            Decimal?        @map("tax_total") @db.Decimal(12, 2)
  discountTotal       Decimal?        @map("discount_total") @db.Decimal(12, 2)
  currency            String          @db.Char(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([orderId], map: "order_item_order_id_idx")
  @@index([variantId], map: "order_item_variant_id_idx")
  @@map("order_item")
}

model OrderAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @unique(map: "order_address_order_id_key") @map("order_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.Text
  line1         String   @db.Text
  line2         String?  @db.Text
  city          String   @db.Text
  region        String?  @db.Text
  postalCode    String   @map("postal_code") @db.Text
  countryCode   String   @map("country_code") @db.Char(2)
  phone         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("order_address")
}

model Payment {
  id                             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                        String               @map("order_id") @db.Uuid
  provider                       PaymentProvider
  providerPaymentId              String?              @map("provider_payment_id") @db.Text
  providerCheckoutSessionId      String?              @map("provider_checkout_session_id") @db.Text
  amount                         Decimal              @db.Decimal(12, 2)
  currency                       String               @db.Char(3)
  status                         PaymentStatus
  reconciliationStatus           ReconciliationStatus @default(NONE) @map("reconciliation_status")
  reconciliationReason           String?              @map("reconciliation_reason") @db.Text
  reconciliationDetectedAt       DateTime?            @map("reconciliation_detected_at") @db.Timestamptz(6)
  reconciliationResolvedAt       DateTime?            @map("reconciliation_resolved_at") @db.Timestamptz(6)
  reconciliationResolvedByUserId String?              @map("reconciliation_resolved_by_user_id") @db.Uuid
  reconciliationResolutionNote   String?              @map("reconciliation_resolution_note") @db.Text
  createdAt                      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                          Order                @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedForOrder               Order?               @relation("AcceptedPayment")
  reconciliationResolvedBy       User?                @relation("PaymentReconciliationResolver", fields: [reconciliationResolvedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  events                         PaymentEvent[]

  @@unique([id, orderId], map: "payment_id_order_id_key")
  @@unique([provider, providerPaymentId], map: "payment_provider_payment_id_key")
  @@unique([provider, providerCheckoutSessionId], map: "payment_provider_checkout_session_id_key")
  @@index([orderId, createdAt], map: "payment_order_id_created_at_idx")
  @@index([reconciliationStatus, updatedAt], map: "payment_reconciliation_status_updated_at_idx")
  @@index([reconciliationResolvedByUserId], map: "payment_reconciliation_resolver_idx")
  @@map("payment")
}

model PaymentEvent {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         PaymentProvider
  providerEventId  String             @map("provider_event_id") @db.Text
  providerObjectId String?            @map("provider_object_id") @db.Text
  paymentId        String?            @map("payment_id") @db.Uuid
  eventType        String             @map("event_type") @db.Text
  processingStatus PaymentEventStatus @map("processing_status")
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?          @map("processed_at") @db.Timestamptz(6)
  errorCode        String?            @map("error_code") @db.Text
  payment          Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerEventId], map: "payment_event_provider_event_id_key")
  @@index([processingStatus, receivedAt], map: "payment_event_processing_status_received_at_idx")
  @@index([paymentId], map: "payment_event_payment_id_idx")
  @@map("payment_event")
}
